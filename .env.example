# Credenciales de la Meta WhatsApp Business Cloud API para el smoke test.
#
# Copia este archivo a `.env` (que ya está en .gitignore) y rellena los valores.
#   cp .env.example .env
#
# NUNCA subas el `.env` al repositorio: PRODUCT.md §61 exige que los tokens
# no vivan ni en el código ni en el repo.

# Token de acceso del sistema (System User) con el permiso whatsapp_business_messaging
META_TOKEN=

# ID de la WhatsApp Business Account (WABA)
META_WABA_ID=

# ID del número de teléfono de WhatsApp Business
META_PHONE_NUMBER_ID=
